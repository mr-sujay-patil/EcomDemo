# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# compose reads .env automatically. Every variable below is required: compose.yaml uses the ${VAR:?}
# form for the secrets, so it refuses to start rather than falling back to a value nobody chose.

# --- PostgreSQL -------------------------------------------------------------
# One server, five databases - ecomdemo_customer, ecomdemo_catalog, ecomdemo_inventory,
# ecomdemo_order, ecomdemo_notification - created on first start by
# docker/postgres/init-databases.sh. POSTGRES_DB below is only the bootstrap database the init
# script connects to; no service uses it.
#
# PostgreSQL has no cross-database joins, which is what makes "one database per service" a rule the
# engine enforces rather than one people have to remember.
POSTGRES_DB=ecomdemo
POSTGRES_USER=ecomdemo

# Any non-empty value. This database is reachable only from the compose network unless you publish
# its port, but pick something that is not "password" anyway.
POSTGRES_PASSWORD=change-me

# --- Authentication ---------------------------------------------------------
# The RSA PRIVATE key that signs JWTs, PKCS#8 PEM. Held by customer-service and by nothing else.
#
# JWT_SECRET is gone as of Phase 20, and the reason is worth understanding rather than just copying.
# HS256 signs and verifies with the same key, so five services that all had to VALIDATE tokens would
# all have needed the key that CREATES them - and notification-service, whose whole job is writing a
# row when an event arrives, would have held everything needed to mint itself an admin token for any
# customer. RS256 splits the key: customer-service holds the private half, the other four fetch the
# public half from http://customer-service:8081/.well-known/jwks.json and can only check signatures.
#
# OPTIONAL. Left unset, customer-service generates a keypair at startup and logs a warning, so a
# fresh clone works with no setup - at the cost that tokens stop working when it restarts. Generate a
# real one with:
#   openssl genpkey -algorithm RSA -pkcs8 -pkeyopt rsa_keygen_bits:2048
#
# It must be a single line or a proper multi-line value; the easiest way to set it without fighting
# shell quoting is:
#   JWT_PRIVATE_KEY="$(openssl genpkey -algorithm RSA -pkcs8 -pkeyopt rsa_keygen_bits:2048)"
#
# Anyone holding this can mint a token for any user, including the administrator.
#JWT_PRIVATE_KEY=

# --- Grafana ----------------------------------------------------------------
# The Grafana admin password. compose.yaml uses the ${VAR:?} form, so the stack refuses to start
# rather than falling back to Grafana's famous admin/admin.
#
# Still required even though Grafana is behind the `observability` profile: compose validates the
# whole file before deciding what to start, so a ${VAR:?} in a service you are not starting still
# stops the stack.
#
# Grafana is published on http://localhost:3000. Anonymous access is disabled, so this is the only
# way in.
GRAFANA_PASSWORD=change-me

# Optional - defaults to "admin" when unset.
GRAFANA_USER=admin

# --- Kafka ------------------------------------------------------------------
# Nothing to set. The broker runs with no authentication on the compose network only, and its
# address is fixed in compose.yaml (kafka:9092) - there is no credential here to leak.
#
# Kafka UI moved to http://localhost:8086 in Phase 20 - customer-service owns 8081 now - and is part
# of the `observability` profile. Use it for topics, partitions, offsets, consumer-group lag and the
# dead-letter topic.
