<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ecomdemo</groupId>
        <artifactId>ecomdemo</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>order-service</artifactId>
    <name>order-service</name>
    <description>Carts, checkout and orders - the one service that orchestrates the others</description>

    <dependencies>
        <!--
            Web, JPA, security, JWT validation, Flyway, actuator and the shared error shape. One
            dependency instead of eleven repeated in five POMs - and, more usefully, one place to
            read what "an EcomDemo service" means.
        -->
        <dependency>
            <groupId>com.ecomdemo</groupId>
            <artifactId>shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            The shared test support: how to mint a token, and how to make @WithMockCustomer reach
            the filter chain. Published by shared-kernel as a test-jar - test code is not transitive,
            so it has to be asked for explicitly and by type.
        -->
        <dependency>
            <groupId>com.ecomdemo</groupId>
            <artifactId>shared-kernel</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!--
            Spring for Apache Kafka. Asynchronous communication between services was already in
            place from Phase 17; the split is what turns it from "a listener in another package" into
            "a listener in another process", which is the only kind of decoupling that survives one
            of the two being down.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!--
            Resilience4j: the circuit breaker, and the retry and bulkhead that go around a REMOTE
            call.
            
            Only this service has it, and only this service should. The other four make no outbound
            calls at all - a circuit breaker with nothing to protect is a dependency that exists to
            be misread later.

            Note the artifact: spring-boot4, not the spring-boot3 that every example still names.
            They are published at the same version and differ in which Spring Boot they
            auto-configure against.

            It brings resilience4j-spring6 (the AOP that makes the annotations work) and
            resilience4j-micrometer, which is what puts resilience4j_circuitbreaker_state on
            /actuator/prometheus without any further wiring.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!--
            AspectJ's annotation types, which Resilience4j's aspects are written with.
            
            Resilience4j implements @CircuitBreaker, @Retry and @Bulkhead as @Aspect classes, and
            neither its starter nor resilience4j-spring6 pulls aspectjweaver in. Without it the
            aspects cannot be parsed, no proxy is created, and every annotation compiles, runs and
            does nothing at all - the same silent failure shape as @Transactional without a proxy, or
            @Retryable without @EnableResilientMethods in Phase 6. That is the single easiest way to
            ship a circuit breaker that is decorative.

            NOT spring-boot-starter-aop, which is what every guide names: Boot 4 dropped that starter
            entirely and the build fails with "version is missing" rather than anything mentioning
            AOP. aspectjweaver is still managed by the Boot BOM, so no version here.
        -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Repackages the jar into an executable archive, and writes
                target/classes/META-INF/build-info.properties so /actuator/info reports something.

                Declared per service rather than on the parent on purpose: shared-kernel must NOT be
                repackaged, because a Boot executable jar puts its classes under BOOT-INF/classes
                where nothing can compile against them.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
