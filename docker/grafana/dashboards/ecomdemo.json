    {
      "type": "state-timeline",
      "title": "Circuit breaker state",
      "datasource": {
        "type": "prometheus",
        "uid": "ecomdemo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "description": "CLOSED = calls flow. OPEN = calls are rejected without being attempted, so a dead dependency costs microseconds instead of a 10s timeout. HALF_OPEN = a few probes are allowed through to find out whether it has recovered.\n\nresilience4j exports one series PER STATE with a 0/1 value rather than a single enum, which is why this plots `max by (state)` rather than the raw metric.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ecomdemo-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (state) (resilience4j_circuitbreaker_state{application=~\"$service\", name=\"catalog\"})",
          "legendFormat": "{{state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
