      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ecomdemo-prometheus"
          },
          "expr": "topk(5, histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=~\"$service\"}[$__rate_interval]))))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
