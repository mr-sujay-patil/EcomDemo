<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The Spring Boot parent POM curates versions for every dependency Boot knows about.
        Because of it, the <dependency> entries below carry no <version> - the parent guarantees
        they are mutually compatible. It also pre-configures the compiler and surefire plugins.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.ecomdemo</groupId>
    <artifactId>ecomdemo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ecomdemo</name>
    <description>Learning project: from Spring Boot monolith to distributed system</description>

    <!--
        Phase 20 turned this POM from "the application" into "the build".

        It has <packaging>pom</packaging>, which means it produces no jar of its own. Its job is to
        list the modules, be their parent, and hold the configuration they all share. `./mvnw clean
        verify` here still builds and tests everything, in the order Maven works out from the
        dependencies between modules - shared-kernel first, because the five services depend on it.

        This is a *multi-module repository*, not a monorepo of unrelated projects: one version
        number, one build, one CI run. That is a deliberate stop on the way to full independence. Each
        service is independently *deployable* (its own image, its own database, its own process),
        which is what this phase is about; making them independently *releasable* means separate
        repositories and separate version numbers, which brings dependency management problems this
        project does not need yet.
    -->
    <packaging>pom</packaging>

    <modules>
        <module>shared-kernel</module>
        <module>services/customer-service</module>
        <module>services/catalog-service</module>
        <module>services/inventory-service</module>
        <module>services/order-service</module>
        <module>services/notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>

        <!--
            Neither of these is managed by the Spring Boot parent - checked against the effective POM
            rather than assumed - so both carry an explicit version. JaCoCo must be at least 0.8.11
            to read Java 21 class files.
        -->
        <jacoco.version>0.8.15</jacoco.version>

        <!--
            Resilience4j is not managed by the Spring Boot BOM, so it carries an explicit version -
            checked against the effective POM rather than assumed.

            2.4.0 is the first line to publish a `resilience4j-spring-boot4` artifact. The
            long-standing `resilience4j-spring-boot3` is still published at the same version and is
            the one every tutorial names; it targets Boot 3 and its auto-configuration binds against
            APIs that moved. Picking the right one of two artifacts that differ by a single digit is
            the whole compatibility question for this phase.
        -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

        <!--
            Where the scanner looks for coverage. Sonar does not measure coverage itself: it reads a
            report somebody else produced, which is why running sonar:sonar without a preceding
            `verify` reports 0% rather than an error.

            ${project.build.directory} resolves per module, so each service reports its own coverage
            and the scanner aggregates them.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco-merged/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>

        <!-- Poll after uploading and fail the build if the gate is red. A gate that cannot fail
             anything is a dashboard. -->
        <sonar.qualitygate.wait>true</sonar.qualitygate.wait>
    </properties>

    <!--
        Inherited by every module. Only things genuinely universal belong here - anything a single
        service needs belongs in that service's POM, so that reading one POM tells you what that
        service actually is.
    -->
    <dependencies>
        <!-- JUnit 5, AssertJ, Mockito and @SpringBootTest. Every module has tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            @WithMockUser and the request post-processors. Every service validates JWTs from this
            phase on, so every service has authorization rules to test.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2 in PostgreSQL mode, for the fast suite. Every service's *Test classes run on it so
            `./mvnw test` needs nothing installed and no network; the *IT classes get a real
            PostgreSQL container instead.

            Test-scoped dependencies are NOT transitive, which is why these live here rather than in
            shared-kernel: a service depending on shared-kernel inherits its compile dependencies and
            none of its test ones. Declaring them on the parent is what gets them to all six modules.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers, and @ServiceConnection to wire the container's random port into the
            context. Every service owns a database, so every service has integration tests that need
            a real one.

            Note the coordinates: Testcontainers 2.x renamed every module with a `testcontainers-`
            prefix, so the `org.testcontainers:postgresql` every tutorial shows is the 1.x line.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Test slices. Spring Boot 4 split the test auto-configurations out of
            spring-boot-test-autoconfigure into per-technology modules, so @WebMvcTest and
            @DataJpaTest each need their own.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JaCoCo measures which lines the tests actually execute, by attaching an agent that
                instruments classes as they are loaded.

                Two agents, because Phase 7 split the suite: one for Surefire's unit and slice tests
                and one for Failsafe's integration tests. They write separate .exec files, which are
                merged into a single report - the integration tests drive real HTTP through the whole
                stack, and a report that ignored them would understate what the suite covers badly
                enough to encourage writing redundant unit tests to make a number go up.

                Declared here rather than in each module: every module gets the same treatment, and
                the merged report lands in that module's own target/.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- Sets argLine so Surefire launches its JVM with the agent attached. -->
                    <execution>
                        <id>prepare-agent-for-unit-tests</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- Same for Failsafe, into a separate destination file. -->
                    <execution>
                        <id>prepare-agent-for-integration-tests</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>

                    <!--
                        Merge after the integration tests have finished, because the agent only
                        flushes its data when the JVM it is attached to exits.
                    -->
                    <execution>
                        <id>merge-coverage-data</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>

                    <!-- The human-readable HTML and the XML the Sonar scanner reads. -->
                    <execution>
                        <id>report-merged-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Uploads sources, issues and the coverage report to a SonarQube server. Runs only when
                asked for explicitly (./mvnw sonar:sonar), so an ordinary build needs no server.
            -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>

            <!--
                Failsafe runs the integration tests (*IT.java); Surefire keeps the unit and slice
                tests (*Test.java). Their default include patterns already draw that line, so the
                only thing needed here is to bind Failsafe's goals - it has none by default.

                Why two plugins rather than one. Surefire fails the build the moment a test fails,
                which for an integration test would abandon the run before post-integration-test and
                leave containers behind. Failsafe deliberately separates running from reporting: the
                integration-test goal records failures, the verify goal is what fails the build, and
                everything in between still executes. That is also why `./mvnw test` needs no Docker
                at all - it never reaches the phases Failsafe binds to.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
