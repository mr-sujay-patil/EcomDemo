<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The Spring Boot parent POM curates versions for every dependency Boot knows about.
        Because of it, the <dependency> entries below carry no <version> - the parent guarantees
        they are mutually compatible. It also pre-configures the compiler and surefire plugins.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.ecomdemo</groupId>
    <artifactId>ecomdemo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ecomdemo</name>
    <description>Learning project: from Spring Boot monolith to distributed system</description>

    <properties>
        <java.version>21</java.version>

        <!--
            Neither of these is managed by the Spring Boot parent - checked against the effective POM
            rather than assumed - so both carry an explicit version. JaCoCo must be at least 0.8.11
            to read Java 21 class files.
        -->
        <jacoco.version>0.8.15</jacoco.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

        <!--
            Where the scanner looks for coverage. Sonar does not measure coverage itself: it reads a
            report somebody else produced, which is why running sonar:sonar without a preceding
            `verify` reports 0% rather than an error.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco-merged/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>

        <!-- Poll after uploading and fail the build if the gate is red. A gate that cannot fail
             anything is a dashboard. -->
        <sonar.qualitygate.wait>true</sonar.qualitygate.wait>
    </properties>

    <dependencies>
        <!-- Spring MVC, embedded Tomcat and Jackson JSON binding. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Hibernate, Spring Data repositories, transaction management and HikariCP. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation, so @Valid on a controller argument is actually enforced. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            OAuth2 Resource Server: validates the Bearer token on every request.

            It pulls in spring-security-oauth2-jose, which carries both NimbusJwtDecoder (verify a
            token) and NimbusJwtEncoder (issue one) - so this single dependency covers both halves of
            the phase. No separate JWT library (jjwt, java-jwt) is needed, and adding one would mean
            two implementations of the same specification in one application.

            "Resource server" is OAuth2's name for the thing that holds the data and accepts tokens,
            as distinct from the authorization server that issues them. Here the application is both,
            which is normal for a self-contained API and is exactly the part that Keycloak or Entra ID
            would take over later.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            Spring Security: the filter chain, BCrypt, HTTP Basic and method security. Adding it to
            the classpath secures every endpoint by default - which is the right default, and the
            reason SecurityConfiguration has to say explicitly which endpoints are public.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            The PostgreSQL JDBC driver, and from this phase on the only database the application
            itself talks to. Runtime scope: no application code imports a driver class - Hibernate
            and HikariCP load it by name from the JDBC URL. The version comes from the parent POM.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            H2 is now TEST scope only. The running application uses PostgreSQL; the test suite keeps
            an embedded database so `./mvnw clean verify` needs nothing installed and no network.
            The cost is fidelity - H2 in PostgreSQL mode is not PostgreSQL - which is precisely the
            gap Phase 7 closes with Testcontainers.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Flyway owns the database schema from Phase 5 on: it creates it, versions it and records
            every change in flyway_schema_history. Hibernate is demoted to validating that the
            entities still match what Flyway built.

            Flyway 10 split the heavyweight database implementations out of flyway-core, so
            PostgreSQL needs its own module - without it Flyway starts and then fails to recognise
            the database. H2 is not in that split: flyway-core still carries it, which is why the
            test suite needs no third dependency. Versions come from the parent POM (Flyway 12.4.0
            under Spring Boot 4.1.1).
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
            Spring Boot's Flyway auto-configuration, which runs the migrations before Hibernate
            builds the EntityManagerFactory and binds the spring.flyway.* properties.

            It is a separate module for the same reason spring-boot-h2console was in Phase 0: Boot 4
            split the auto-configurations out of spring-boot-autoconfigure per technology. Without
            it Flyway sits on the classpath and simply never runs - no error, no log line, just an
            empty database and a `Schema validation: missing table` failure from Hibernate that
            points nowhere near the actual cause.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- JUnit 5, AssertJ, @SpringBootTest and TestRestTemplate. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers: a real PostgreSQL in a Docker container, started by the build and thrown
            away after it. This is what finally lets the integration tests run on the same engine
            production does, rather than on H2 pretending to be it.

            Note the coordinates. Testcontainers 2.x renamed every module with a `testcontainers-`
            prefix, so the `org.testcontainers:postgresql` that every tutorial and older answer uses
            does not exist at 2.0.5 - its last release is 1.21.4, on the previous line. Pairing that
            with a 2.x core would be a silent incompatibility. Versions come from the
            testcontainers-bom the Spring Boot parent already imports.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            @ServiceConnection, which points the application's DataSource at whatever host and port
            the container happened to get - no @DynamicPropertySource wiring by hand.

            Its own module, for the same reason spring-boot-h2console and spring-boot-flyway were:
            Boot 4 splits auto-configuration per technology.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            @WithMockUser and the httpBasic() request post-processor. Without this, testing an
            authorization rule would mean authenticating for real in every test.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Test slices. Spring Boot 4 split the test auto-configurations out of
            spring-boot-test-autoconfigure into per-technology modules, the same way it did for the
            H2 console in Phase 0, so @WebMvcTest and @DataJpaTest each need their own module.
            Versions come from the parent POM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Failsafe runs the integration tests (*IT.java); Surefire keeps the unit and slice
                tests (*Test.java). Their default include patterns already draw that line, so the
                only thing needed here is to bind Failsafe's goals - it has none by default.

                Why two plugins rather than one. Surefire fails the build the moment a test fails,
                which for an integration test would abandon the run before post-integration-test and
                leave containers behind. Failsafe deliberately separates running from reporting: the
                integration-test goal records failures, the verify goal is what fails the build, and
                everything in between still executes. That is also why `./mvnw test` needs no Docker
                at all - it never reaches the phases Failsafe binds to.
            -->
            <!--
                JaCoCo measures which lines the tests actually execute, by attaching an agent that
                instruments classes as they are loaded.

                Two agents, because Phase 7 split the suite: one for Surefire's unit and slice tests
                and one for Failsafe's integration tests. They write separate .exec files, which are
                merged into a single report - the 28 integration tests drive real HTTP through the
                whole stack, and a report that ignored them would understate what the suite covers
                badly enough to encourage writing redundant unit tests to make a number go up.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- Sets argLine so Surefire launches its JVM with the agent attached. -->
                    <execution>
                        <id>prepare-agent-for-unit-tests</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- Same for Failsafe, into a separate destination file. -->
                    <execution>
                        <id>prepare-agent-for-integration-tests</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>

                    <!--
                        Merge after the integration tests have finished, because the agent only
                        flushes its data when the JVM it is attached to exits.
                    -->
                    <execution>
                        <id>merge-coverage-data</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>

                    <!-- The human-readable HTML and the XML the Sonar scanner reads. -->
                    <execution>
                        <id>report-merged-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Uploads sources, issues and the coverage report to a SonarQube server. Runs only when
                asked for explicitly (./mvnw sonar:sonar), so an ordinary build needs no server.
            -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
